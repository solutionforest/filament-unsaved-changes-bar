{
    "name": "solutionforest/filament-unsaved-changes-bar",
    "description": "A floating Shopify / Laravel Cloud-style \"Unsaved changes · Discard · Save\" bar for Filament 5 panel forms.",
    "keywords": [
        "solutionforest",
        "laravel",
        "filament",
        "filament-plugin",
        "unsaved-changes"
    ],
    "homepage": "https://github.com/solutionforest/filament-unsaved-changes-bar",
    "license": "MIT",
    "authors": [
        {
            "name": "Solution Forest",
            "email": "info@solutionforest.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "orchestra/testbench": "^9.5|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "laravel/octane": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "SolutionForest\\FilamentUnsavedChangesBar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SolutionForest\\FilamentUnsavedChangesBar\\Tests\\": "tests/",
            "Demo\\App\\": "demo/app/",
            "Demo\\Database\\Seeders\\": "demo/database/seeders/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint",
        "demo:build": [
            "@php vendor/bin/testbench workbench:build --ansi",
            "@php vendor/bin/testbench filament:assets --ansi"
        ],
        "demo": [
            "Composer\\Config::disableProcessTimeout",
            "@demo:build",
            "@php vendor/bin/testbench serve --host=127.0.0.1 --port=8000 --ansi"
        ],
        "demo:octane": [
            "Composer\\Config::disableProcessTimeout",
            "@demo:build",
            "@php vendor/bin/testbench octane:start --server=swoole --host=127.0.0.1 --port=8000 --ansi"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SolutionForest\\FilamentUnsavedChangesBar\\UnsavedChangesBarServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
